<header>
  <span class="brand">Rural Clinic HMS</span>
  <% if (typeof actor !== 'undefined' && actor) { %>
    <nav>
      <a href="/dashboard">Dashboard</a>
      <% if (['Receptionist','Doctor'].includes(actor.activeRole)) { %>
        <a href="/patients">Find patient</a>
        <a href="/queue">Queue</a>
      <% } %>
      <% if (actor.activeRole === 'Receptionist') { %>
        <a href="/patients/new">Register patient</a>
        <a href="/availability">Availability</a>
      <% } %>
      <% if (actor.activeRole === 'Doctor') { %>
        <a href="/doctor/appointments">Appointments</a>
        <a href="/doctor/patients">My patients</a>
        <a href="/medicines">Pharmacy stock</a>
        <a href="/equipment">Equipment</a>
      <% } %>
      <% if (actor.activeRole === 'Admin') { %>
        <a href="/admin/staff">Staff</a>
        <a href="/admin/availability">Availability</a>
        <a href="/admin/rooms">Rooms</a>
        <a href="/equipment">Equipment</a>
        <a href="/admin/accommodations">Accommodations</a>
        <a href="/admin/consent">Consent</a>
        <a href="/admin/directory">Directory</a>
        <a href="/admin/facility">Facility</a>
      <% } %>
      <% if (actor.activeRole === 'Pharmacy') { %>
        <a href="/pharmacy/lookup">Prescription lookup</a>
        <a href="/pharmacy/stock">Stock &amp; prices</a>
        <a href="/pharmacy/purchases">Purchases</a>
        <a href="/pharmacy/billing">Billing</a>
      <% } %>
      <% if (actor.activeRole === 'Technician') { %>
        <a href="/technician">Lab tests</a>
        <a href="/technician/ehr">Specialty records</a>
        <a href="/equipment">Equipment</a>
      <% } %>
      <a href="/directory">Hospitals &amp; pharmacies</a>
      <% if (actor.activeRole !== 'Doctor') { %><a href="/insurance-plans">Insurance</a><% } %>
      <a href="/notifications">Notifications</a>
      <% if (typeof devMailbox !== 'undefined' && devMailbox) { %>
        <a href="/mailbox">Mailbox</a>
      <% } %>
    </nav>
    <span class="spacer"></span>
    <span class="who"><%= actor.name %> · <%= actor.activeRole %> · <%= actor.facilityCode %></span>
    <form method="post" action="/logout" style="margin:0">
      <button class="secondary" type="submit">Sign out</button>
    </form>
  <% } %>
</header>
<% if (typeof notice !== 'undefined' && notice) { %>
  <div style="max-width:860px;margin:16px auto 0;padding:0 20px"><div class="ok" role="status"><%= notice %></div></div>
<% } %>
