<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= title %> — Bamboo HMS</title>
  <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A//www.w3.org/2000/svg%22%20viewBox%3D%220%200%2032%2032%22%3E%3Crect%20width%3D%2232%22%20height%3D%2232%22%20rx%3D%228%22%20fill%3D%22%230a7d6b%22/%3E%3Crect%20x%3D%2212.5%22%20y%3D%224%22%20width%3D%227%22%20height%3D%227.5%22%20rx%3D%222%22%20fill%3D%22%23fff%22/%3E%3Crect%20x%3D%2212.5%22%20y%3D%2212.5%22%20width%3D%227%22%20height%3D%227.5%22%20rx%3D%222%22%20fill%3D%22%23fff%22/%3E%3Crect%20x%3D%2212.5%22%20y%3D%2221%22%20width%3D%227%22%20height%3D%227%22%20rx%3D%222%22%20fill%3D%22%23fff%22/%3E%3Cpath%20d%3D%22M19.5%2012C23%207.5%2026.5%207%2028.5%207.5C26.5%2011%2023.5%2012.8%2019.5%2012Z%22%20fill%3D%22%239be3c0%22/%3E%3Cpath%20d%3D%22M12.5%2020.5C9%2016%205.5%2015.5%203.5%2016C5.5%2019.5%208.5%2021.3%2012.5%2020.5Z%22%20fill%3D%22%239be3c0%22/%3E%3C/svg%3E" />
  <style>
    :root { --fg:#1b2a33; --muted:#5b7280; --line:#dfe6ea; --accent:#0a7d6b; --bg:#f6f9fa; }
    * { box-sizing: border-box; }
    body { margin:0; font-family: system-ui, sans-serif; color:var(--fg); background:var(--bg); }
    /* ---- Header: [hamburger + pinned links] [brand, centered] [user + sign out] ---- */
    :root { --header-h:56px; --drawer-w:240px; --shrink:.92; }
    /* Simple headers (login, invite, patient portal) keep a plain flex row. */
    header { background:#fff; border-bottom:1px solid var(--line); padding:12px 20px; display:flex; align-items:center; gap:16px; flex-wrap:wrap; }
    header .brand { font-weight:700; color:var(--accent); text-decoration:none; white-space:nowrap;
                    display:inline-flex; align-items:center; gap:8px; }
    header .brand .logo-mark { flex:none; display:block; }
    header .brand .brand-word { font-size:18px; letter-spacing:-.2px; }
    header .brand .brand-sub { font-weight:500; color:var(--muted); margin-left:4px; font-size:.8em; letter-spacing:.6px; }
    header .spacer { flex:1; }
    /* Staff header: three columns so the brand stays centered. */
    header.site-header { padding:0 20px; min-height:var(--header-h); display:grid; grid-template-columns:1fr auto 1fr;
                         position:sticky; top:0; z-index:30; }
    header.site-header .brand { justify-self:center; }
    .header-left { display:flex; align-items:center; gap:10px; min-width:0; }
    .header-right { justify-self:end; display:flex; align-items:center; gap:12px; }
    header nav a { margin-right:14px; color:var(--fg); text-decoration:none; font-size:14px; }
    header nav a:hover { text-decoration:underline; }
    header nav.main-nav { display:flex; align-items:center; flex-wrap:wrap; }
    header .who { font-size:13px; color:var(--muted); }

    /* ---- Hamburger + side menu ---- */
    .nav-toggle-input { position:absolute; opacity:0; width:1px; height:1px; pointer-events:none; }
    .nav-toggle-btn { display:flex; align-items:center; justify-content:center; width:36px; height:36px;
                      border-radius:7px; color:#6b7b85; cursor:pointer; flex:none; }
    .nav-toggle-btn:hover, .nav-toggle-input:checked ~ header .nav-toggle-btn { background:#eef2f3; color:var(--fg); }
    .nav-toggle-input:focus-visible ~ header .nav-toggle-btn { outline:2px solid var(--accent); outline-offset:2px; }
    .hamburger { width:22px; height:22px; }

    .nav-drawer { position:fixed; top:var(--header-h); left:0; bottom:0; width:var(--drawer-w); z-index:25;
                  background:#fff; border-right:1px solid var(--line); overflow-y:auto; padding:8px;
                  transform:translateX(-100%); visibility:hidden; transition:transform .2s ease, visibility .2s; }
    .nav-toggle-input:checked ~ .nav-drawer { transform:none; visibility:visible; }
    .nav-drawer-head { display:flex; align-items:center; justify-content:space-between; padding:6px 10px 10px;
                       font-size:12px; text-transform:uppercase; letter-spacing:.5px; color:var(--muted); }
    .nav-drawer-close { cursor:pointer; font-size:20px; line-height:1; color:#8a969d; padding:0 4px; }
    .nav-drawer nav a { display:flex; align-items:center; gap:10px; padding:8px 10px; border-radius:6px;
                        font-size:14px; color:var(--fg); text-decoration:none; }
    .nav-drawer nav a:hover { background:#f2f5f6; }
    .nav-icon { width:18px; height:18px; flex:none; color:#8a969d; }
    .nav-backdrop { display:none; }

    main { max-width:860px; margin:24px auto; padding:0 20px; }
    .page-notice { max-width:860px; margin:16px auto 0; padding:0 20px; }
    .page-footer { max-width:860px; margin:30px auto; padding:0 20px; color:#8aa0ab; font-size:12px; }

    /* Wide screens: the open menu sits beside the page. The page moves right to
       make room and shrinks slightly (zoom) so it doesn't feel cramped.
       Padding/width are divided by --shrink because zoom scales them too. */
    @media (min-width: 761px) {
      .nav-toggle-input:checked ~ main {
        zoom:var(--shrink);
        max-width:calc(860px + var(--drawer-w) / var(--shrink));
        padding-left:calc((var(--drawer-w) + 24px) / var(--shrink));
      }
      .nav-toggle-input:checked ~ .page-notice,
      .nav-toggle-input:checked ~ .page-footer {
        max-width:calc(860px + var(--drawer-w));
        padding-left:calc(var(--drawer-w) + 24px);
      }
    }

    /* Narrow screens: links wrap to their own row, and the menu covers the
       page with a dimmed backdrop instead of squeezing it. */
    @media (max-width: 760px) {
      header.site-header { display:flex; flex-wrap:wrap; padding:8px 14px; gap:8px 12px; }
      .header-left { display:contents; }
      .nav-toggle-btn { order:1; }
      header.site-header .brand { order:2; flex:1; text-align:center; }
      .header-right { order:3; }
      header.site-header nav.main-nav { order:4; width:100%; }
      header.site-header .who { display:none; }
      .nav-drawer { top:0; z-index:40; }
      .nav-toggle-input:checked ~ .nav-backdrop { display:block; position:fixed; inset:0; z-index:35; background:rgba(0,0,0,.25); }
    }
    h1 { font-size:22px; }
    .card { background:#fff; border:1px solid var(--line); border-radius:10px; padding:18px; margin-bottom:16px; }
    label { display:block; font-size:13px; color:var(--muted); margin:10px 0 4px; }
    input, select, textarea { width:100%; padding:9px 10px; border:1px solid var(--line); border-radius:7px; font-size:14px; }
    button, .btn { background:var(--accent); color:#fff; border:0; padding:9px 14px; border-radius:7px; font-size:14px; cursor:pointer; text-decoration:none; display:inline-block; }
    button.secondary, .btn.secondary { background:#eef2f3; color:var(--fg); }
    table { width:100%; border-collapse:collapse; font-size:14px; }
    th, td { text-align:left; padding:8px 10px; border-bottom:1px solid var(--line); }
    .pill { font-size:12px; padding:2px 8px; border-radius:999px; background:#eef2f3; }
    .pill.Waiting { background:#fff3cd; } .pill.InProgress { background:#cfe2ff; } .pill.Completed { background:#d1e7dd; }
    .pill.prio-Low { background:#e2e8f0; } .pill.prio-Medium { background:#fde9c8; } .pill.prio-High { background:#f8c9c9; }
    .code { font-family: ui-monospace, Menlo, Consolas, monospace; background:#eef2f3; padding:2px 8px; border-radius:6px; letter-spacing:1px; }
    .error { background:#fde8e8; border:1px solid #f5b5b5; color:#8a1f1f; padding:10px 12px; border-radius:7px; margin-bottom:12px; }
    .ok { background:#d1e7dd; border:1px solid #a3cfbb; color:#0f5132; padding:10px 12px; border-radius:7px; margin-bottom:12px; }
    .muted { color:var(--muted); font-size:13px; }
    .stat { display:inline-block; min-width:150px; margin:8px 16px 8px 0; }
    .stat .n { font-size:30px; font-weight:700; color:var(--accent); }
    .row { display:flex; gap:10px; flex-wrap:wrap; }
    .grid3 { display:grid; grid-template-columns: 1fr 1fr 1fr; gap:10px; }
    .grid4 { display:grid; grid-template-columns: 1.4fr 1fr 1.4fr 0.8fr; gap:10px; }
    @media print { header, .no-print { display:none; } }
  </style>
</head>
<body>
