<header>
  <span class="brand"><%- include('logo') %></span>
  <% if (typeof patient !== 'undefined' && patient) { %>
    <nav aria-label="Patient menu">
      <a href="/portal/home">My visits</a>
      <a href="/portal/appointments">Appointments</a>
      <a href="/portal/medications">My medicines</a>
      <a href="/portal/billing">Bills &amp; costs</a>
      <a href="/portal/health-record">Health record</a>
      <a href="/portal/access">Who can see my records</a>
      <a href="/portal/wearables">Wearable data</a>
      <a href="/portal/accommodations">Accommodations</a>
      <a href="/medicines">Medicine prices</a>
      <a href="/directory">Hospitals &amp; pharmacies</a>
      <a href="/insurance-plans">Insurance plans</a>
    </nav>
    <span class="spacer"></span>
    <span class="who"><%= patient.name %></span>
    <form method="post" action="/portal/logout" style="margin:0">
      <button class="secondary" type="submit">Sign out</button>
    </form>
  <% } %>
</header>
<% if (typeof notice !== 'undefined' && notice) { %>
  <div style="max-width:860px;margin:16px auto 0;padding:0 20px"><div class="ok" role="status"><%= notice %></div></div>
<% } %>
