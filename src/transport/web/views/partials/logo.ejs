<%# Bamboo HMS brand lockup: mark (bamboo stalk on a teal tile) + wordmark.
    Inline SVG so it renders with no static-file serving. Decorative mark is
    aria-hidden; the wordmark text carries the accessible name. %>
<svg class="logo-mark" viewBox="0 0 32 32" width="28" height="28" aria-hidden="true" focusable="false">
  <rect width="32" height="32" rx="8" fill="#0a7d6b"/>
  <!-- stalk: three segments with node gaps -->
  <rect x="12.5" y="4"    width="7" height="7.5" rx="2" fill="#ffffff"/>
  <rect x="12.5" y="12.5" width="7" height="7.5" rx="2" fill="#ffffff"/>
  <rect x="12.5" y="21"   width="7" height="7"   rx="2" fill="#ffffff"/>
  <!-- leaves sprouting from the nodes -->
  <path d="M19.5 12 C23 7.5 26.5 7 28.5 7.5 C26.5 11 23.5 12.8 19.5 12 Z" fill="#9be3c0"/>
  <path d="M12.5 20.5 C9 16 5.5 15.5 3.5 16 C5.5 19.5 8.5 21.3 12.5 20.5 Z" fill="#9be3c0"/>
</svg>
<span class="brand-word">Bamboo<span class="brand-sub">HMS</span></span>
