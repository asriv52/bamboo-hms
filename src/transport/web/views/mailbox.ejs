<%- include('partials/head') %>
<main>
  <% if (recipients.length === 0) { %>
    <div class="card">
      <p class="muted">No emails captured yet. Run a flow (register a patient, finalize a visit,
      invite staff) with <span class="code">EMAIL_PROVIDER=mailbox</span> and they will appear here.</p>
    </div>
  <% } else { %>
    <div class="card">
      <nav class="tabs" style="display:flex; gap:8px; flex-wrap:wrap; margin-bottom:14px;">
        <% recipients.forEach(function(addr){ %>
          <a
            href="/mailbox?to=<%= encodeURIComponent(addr) %>"
            class="btn <%= addr === active ? '' : 'secondary' %>"
            style="font-size:13px;"
          ><%= addr %> (<%= counts[addr] %>)</a>
        <% }); %>
      </nav>

      <div class="row" style="justify-content:space-between; align-items:center;">
        <h2 style="font-size:18px; margin:0;">Inbox: <span class="code"><%= active %></span></h2>
        <form method="post" action="/mailbox/clear" style="margin:0;">
          <button class="secondary" type="submit">Clear all</button>
        </form>
      </div>

      <% if (emails.length === 0) { %>
        <p class="muted">No emails for this recipient.</p>
      <% } else { %>
        <% emails.forEach(function(m){ %>
          <div class="card" style="margin-top:14px;">
            <div class="muted"><%= m.capturedAt.slice(0,19).replace('T',' ') %> UTC · #<%= m.id %></div>
            <h3 style="margin:6px 0 10px; font-size:16px;"><%= m.subject %></h3>
            <label>Plain text</label>
            <pre style="white-space:pre-wrap; background:#eef2f3; padding:10px; border-radius:7px; font-size:13px; margin:0 0 12px;"><%= m.text %></pre>
            <label>Rendered HTML</label>
            <%
              // Dev-only testing tool: the HTML comes from our own email
              // templates, so we render it inline (not in a sandboxed iframe)
              // so links are clickable. A script below forces links to open in
              // a new tab so clicking one never navigates the mailbox away.
            %>
            <div class="email-html" style="border:1px solid var(--line); border-radius:7px; background:#fff; padding:14px;">
              <%- m.html %>
            </div>
          </div>
        <% }); %>
      <% } %>
    </div>
  <% } %>

  <p class="muted" id="mailbox-status" style="margin-top:14px;">
    Auto-refreshing for new mail… <span id="mailbox-dot">●</span>
  </p>
</main>

<script>
  (function () {
    // Open every link inside a rendered email in a new tab, so clicking one
    // never navigates the mailbox page away.
    document.querySelectorAll('.email-html a').forEach(function (a) {
      a.setAttribute('target', '_blank');
      a.setAttribute('rel', 'noopener noreferrer');
    });

    // Auto-reload: poll the capture count and reload only when it changes,
    // preserving the currently selected recipient tab (the ?to= query param).
    var current = <%= typeof total !== 'undefined' ? total : 0 %>;
    var status = document.getElementById('mailbox-status');
    var dot = document.getElementById('mailbox-dot');
    var blink = true;
    setInterval(function () {
      if (dot) { dot.style.opacity = (blink = !blink) ? '1' : '0.25'; }
    }, 1000);

    function poll() {
      fetch('/mailbox/count', { headers: { Accept: 'application/json' }, cache: 'no-store' })
        .then(function (r) {
          if (!r.ok) throw new Error('count route returned ' + r.status);
          return r.json();
        })
        .then(function (data) {
          if (typeof data.total === 'number' && data.total !== current) {
            window.location.reload();
          }
        })
        .catch(function (err) {
          // Surface the failure instead of hiding it — most often this means
          // the dev server predates the /mailbox/count route and needs a
          // restart.
          if (status) {
            status.innerHTML =
              'Auto-refresh unavailable (' + err.message +
              '). Restart the dev server, then reload this page.';
          }
        });
    }

    poll();
    setInterval(poll, 3000);
  })();
</script>
<%- include('partials/foot') %>
