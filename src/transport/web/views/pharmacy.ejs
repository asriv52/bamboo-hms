<%- include('partials/head') %>
<%- include('partials/nav') %>
<main>
  <h1>Pharmacy lookup</h1>
  <% if (dispensed) { %><div class="ok">Dispensing recorded.</div><% } %>
  <div class="card">
    <form method="get" action="/pharmacy/lookup">
      <label>Prescription lookup token (from the patient's email)</label>
      <div class="row">
        <input type="text" name="token" value="<%= token %>" placeholder="Paste the token / link code" />
        <button type="submit">Look up</button>
      </div>
    </form>
    <% if (error) { %><div class="error" style="margin-top:12px"><%= error %></div><% } %>
  </div>

  <% if (view) { %>
    <div class="card">
      <h2 style="margin-top:0">Active medication plan</h2>
      <p class="muted">Patient: <b><%= view.patientName %></b> · Prescription #<%= view.prescriptionId %></p>
      <p class="muted">You can see the active plan only — diagnoses and clinical notes are not shared with the pharmacy.</p>
      <table>
        <thead><tr><th>Medication</th><th>Dosage</th><th>Instructions</th></tr></thead>
        <tbody>
          <% view.medications.forEach(function(m){ %>
            <tr><td><%= m.name %></td><td><%= m.dosage || '—' %></td><td><%= m.instructions || '—' %></td></tr>
          <% }); %>
        </tbody>
      </table>
      <form method="post" action="/pharmacy/dispense" style="margin-top:12px">
        <input type="hidden" name="prescriptionId" value="<%= view.prescriptionId %>" />
        <input type="hidden" name="token" value="<%= token %>" />
        <h3 style="font-size:15px">Record a dispensing</h3>
        <div class="row">
          <div style="flex:2">
            <label for="stockItemId">From your stock (bills the patient)</label>
            <select id="stockItemId" name="stockItemId">
              <option value="">— Not from stock —</option>
              <% view.matchingStock.forEach(function(s){ %>
                <option value="<%= s.id %>"><%= s.medicationName %> — <%= money(s.unitPriceCents) %> each, <%= s.quantity %> left</option>
              <% }); %>
            </select>
          </div>
          <div style="flex:1"><label for="quantity">Quantity</label><input id="quantity" type="number" name="quantity" min="1" /></div>
        </div>
        <label for="itemsDispensed">What was given (optional when picking from stock)</label>
        <input id="itemsDispensed" type="text" name="itemsDispensed" placeholder="e.g. Amoxicillin 500mg x14" />
        <div style="margin-top:10px"><button type="submit">Record dispensing</button></div>
      </form>
    </div>

    <div class="card">
      <h2 style="margin-top:0">Medication history</h2>
      <p class="muted">Shown because this patient has a valid prescription. Medicines and dates only.</p>
      <table>
        <thead><tr><th>Issued</th><th>Medicines</th><th>Status</th></tr></thead>
        <tbody>
          <% view.history.forEach(function(h){ %>
            <tr>
              <td><%= h.date %></td>
              <td><%= h.medications.map(function(m){ return m.name + ' ' + m.dosage; }).join(', ') %></td>
              <td><span class="pill <%= h.active ? 'Completed' : '' %>"><%= h.active ? 'Active' : 'Discontinued' %></span></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  <% } %>
</main>
<%- include('partials/foot') %>
