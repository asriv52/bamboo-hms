<%- include('partials/head') %>
<%- include('partials/nav') %>
<main>
  <h1>Specialty records</h1>
  <p class="muted">Patients assigned to you by a doctor. You only see records in your own specialty.</p>
  <% if (patients.length === 0) { %>
    <div class="card"><p class="muted">No patients are assigned to you yet.</p></div>
  <% } %>
  <% patients.forEach(function(p){ %>
    <div class="card">
      <h2 style="margin-top:0"><%= p.patientName %> <span class="pill"><%= p.category %></span></h2>
      <% if (p.records.length === 0) { %>
        <p class="muted">No <%= p.category %> records yet.</p>
      <% } else { %>
        <table>
          <thead><tr><th>Date</th><th>Entry</th></tr></thead>
          <tbody>
            <% p.records.forEach(function(r){ %>
              <tr><td><%= r.createdAt.slice(0,10) %></td><td><b><%= r.title %></b><br/><%= r.content %></td></tr>
            <% }); %>
          </tbody>
        </table>
      <% } %>
    </div>
  <% }); %>
</main>
<%- include('partials/foot') %>
