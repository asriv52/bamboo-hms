<%- include('partials/head') %>
<header><span class="brand">Rural Clinic HMS</span></header>
<main>
  <h1>Activate your account</h1>
  <div class="card">
    <% if (error) { %><div class="error"><%= error %></div><% } %>
    <% if (invite) { %>
      <p class="muted">You were invited to <b><%= invite.facilityCode %></b> as
        <b><%= invite.roles.join(', ') %></b> in the <b><%= invite.department %></b> department.</p>
      <form method="post" action="/invite/<%= token %>">
        <label>Your email</label>
        <input type="email" value="<%= invite.email %>" disabled />
        <label>Full name *</label>
        <input type="text" name="name" required />
        <label>Choose a password * (min 6 characters)</label>
        <input type="password" name="password" required />
        <div style="margin-top:14px"><button type="submit">Activate account</button></div>
      </form>
    <% } else { %>
      <p class="muted">This invitation link can't be used. Ask your administrator to send a new one.</p>
      <a class="btn secondary" href="/login">Go to sign in</a>
    <% } %>
  </div>
</main>
<%- include('partials/foot') %>
