<%- include('partials/head') %>
<%- include('partials/nav-any') %>
<main>
  <h1>Insurance marketplace</h1>
  <p class="muted">Plans available in the market. The coverage percentage is the share of a bill the plan pays.</p>
  <div class="card">
    <% if (plans.length === 0) { %>
      <p class="muted">No plans are listed yet.</p>
    <% } else { %>
      <table>
        <thead><tr><th>Plan</th><th>Provider</th><th>Monthly premium</th><th>Covers</th><th>Details</th></tr></thead>
        <tbody>
          <% plans.forEach(function(p){ %>
            <tr>
              <td><b><%= p.name %></b></td>
              <td><%= p.provider %></td>
              <td><%= money(p.monthlyPremiumCents) %></td>
              <td><%= p.coveragePercent %>%</td>
              <td><%= p.description || '—' %></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    <% } %>
  </div>
</main>
<%- include('partials/foot') %>
