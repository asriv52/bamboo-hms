# Example environment variables — copy to .env and fill in real values locally.
# Never commit real secrets. .env is gitignored.

# Database connection string (SQLite for local dev, Postgres for deploy)
# For local dev the app uses a SQLite file; this path is relative to the project root.
DATABASE_URL=hms.db

# Secret used to sign session cookies (generate a random value locally)
SESSION_SECRET=dev-only-change-me

# HTTP port the web server listens on
PORT=3000

# Email provider configuration.
# Leave EMAIL_PROVIDER=console to print emails to the server log (default for the demo).
# Set EMAIL_PROVIDER=mailbox to capture emails into the dev-only /mailbox page
#   (an in-memory virtual mailbox for testing flows without a real provider;
#   the /mailbox route is only mounted when NODE_ENV is not 'production').
# Set EMAIL_PROVIDER=smtp and fill the SMTP_* values to send real email.
EMAIL_PROVIDER=mailbox
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# EMAIL_FROM=clinic@example.org

# Base URL used to build links inside emails (unsubscribe, pharmacy lookup).
PUBLIC_BASE_URL=http://localhost:3000

# Key used to encrypt PII at rest (32+ chars recommended). Change locally.
PII_ENCRYPTION_KEY=dev-only-pii-key-change-me-please

# Separate key for the wearable re-identification vault (pseudonym -> patient).
# Must differ from PII_ENCRYPTION_KEY. Rotating it makes existing pseudonyms
# permanently unlinkable.
WEARABLE_REID_KEY=dev-only-wearable-reid-key-change-me

# WHOOP developer app (https://developer.whoop.com). Leave WHOOP_CLIENT_ID empty
# to run the wearable module in simulated mode with synthetic data.
# WHOOP_CLIENT_ID=
# WHOOP_CLIENT_SECRET=
# WHOOP_REDIRECT_URI=http://localhost:3000/portal/wearables/whoop/callback
